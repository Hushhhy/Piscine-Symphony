<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Index{% endblock %}</title>
    </head>
    <body>
        {% block body %}
            {{ form(form) }}
            <table>
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Enable</th>
                        <th>Birth Date</th>
                        <th>Address</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td>{{ user.username }}</td>
                        <td>{{ user.name }}</td>
                        <td>{{ user.email }}</td>
                        <td>{{ user.enable }}</td>
                        <td>{{ user.birthdate }}</td>
                        <td>{{ user.address }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% for message in app.flashes('success') %}
                <div>{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('failure') %}
                <div>{{ message }}</div>
            {% endfor %}
        {% endblock %}
    </body>
</html>